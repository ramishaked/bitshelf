# Copy to .env (web) and set EXPO_PUBLIC_* in apps/mobile/.env for Expo.
# Never commit real values.

# Neon Postgres connection string, from the Neon dashboard
DATABASE_URL=

# Clerk, from the Clerk dashboard (enable Apple, Google and email code)
# Secret key, server side only (Next.js API routes)
CLERK_SECRET_KEY=
# Publishable key for the web app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Same publishable key, exposed to the Expo app
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Cloudflare R2 (photos). Create a bucket and an API token with object read/write.
# Account id from the Cloudflare dashboard
R2_ACCOUNT_ID=
# Access key id of the R2 API token
R2_ACCESS_KEY_ID=
# Secret of the R2 API token
R2_SECRET_ACCESS_KEY=
# Bucket name, for example bitshelf-photos
R2_BUCKET=
# Public base URL serving the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_BASE_URL=

# Claude API key for item identification, used from week 3
ANTHROPIC_API_KEY=

# eBay Browse API credentials for asking prices, used from week 6
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
