{
  "expo": {
    "name": "BitShelf",
    "slug": "bitshelf",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bitshelf",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ramishaked.bitshelf"
    },
    "android": {
      "package": "com.ramishaked.bitshelf",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "BitShelf מצלם את פריטי האוסף שלך. BitShelf photographs your collection items.",
          "photosPermission": "BitShelf בוחר תמונות של פריטי האוסף מהספרייה. BitShelf picks collection item photos from your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}
